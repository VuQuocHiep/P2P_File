{
  "name": "peermesh-frontend",
  "private": true,
  "scripts": {
    "test": "node --experimental-vm-modules --test source/test/frontend/*.test.cjs source/client/src/test/resources/*.test.cjs source/server/src/test/resources/*.test.cjs",
    "test:browser": "npm --prefix source/frontend run build && node source/test/frontend/browser.cjs",
    "format": "prettier --write \"source/frontend/src/**/*.{js,jsx,scss,html}\" source/frontend/vite.config.js \"source/test/frontend/*.cjs\" \"source/{client,server}/src/test/resources/*.cjs\"",
    "format:check": "prettier --check \"source/frontend/src/**/*.{js,jsx,scss,html}\" source/frontend/vite.config.js \"source/test/frontend/*.cjs\" \"source/{client,server}/src/test/resources/*.cjs\""
  },
  "devDependencies": {
    "playwright": "1.62.0",
    "prettier": "3.6.2"
  }
}
